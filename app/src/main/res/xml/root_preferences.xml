<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:iconSpaceReserved="false">

    <SwitchPreferenceCompat
        android:key="@string/key_paused"
        android:title="@string/title_paused"
        android:summary="@string/summary_paused"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="@string/key_pro"
        android:title="@string/title_pro"
        android:summary="@string/summary_pro"
        app:iconSpaceReserved="false" />

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/header_sms">

        <SwitchPreferenceCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:key="@string/key_enable_sms"
            app:iconSpaceReserved="false"
            app:title="@string/enable_sms" />
        <EditTextPreference
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:defaultValue=""
            android:key="@string/key_target_sms"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="@string/target_title_sms"
            app:iconSpaceReserved="false"
            app:summary="@string/target_summary_sms" />

    </PreferenceCategory>
    <PreferenceCategory
        app:title="@string/header_telegram"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="@string/key_enable_telegram"
            app:title="@string/enable_telegram" />
        <EditTextPreference
            android:defaultValue=""
            android:key="@string/key_target_telegram"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="@string/target_title_telegram"
            android:summary="@string/target_summary_telegram"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            android:defaultValue=""
            android:key="@string/key_telegram_apikey"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="@string/title_telegram_apikey"
            android:summary="@string/summary_telegram_apikey"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/header_web"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="@string/key_enable_web"
            app:title="@string/enable_web" />
        <EditTextPreference
            android:defaultValue=""
            android:key="@string/key_target_web"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="@string/target_title_web"
            android:summary="@string/target_summary_web"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:key="@string/key_web_format"
            android:title="@string/title_web_format"
            android:defaultValue="json"
            android:entries="@array/web_format_entries"
            android:entryValues="@array/web_format_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/header_email"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="@string/key_enable_email"
            app:iconSpaceReserved="false"
            app:title="@string/enable_email" />
        <EditTextPreference
            android:defaultValue=""
            android:key="@string/key_email_to"
            android:title="@string/title_email_to"
            android:summary="@string/summary_email_to"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            android:defaultValue="smtp.gmail.com"
            android:key="@string/key_smtp_host"
            android:title="@string/title_smtp_host"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            android:defaultValue="465"
            android:key="@string/key_smtp_port"
            android:title="@string/title_smtp_port"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            android:defaultValue=""
            android:key="@string/key_smtp_user"
            android:title="@string/title_smtp_user"
            android:summary="@string/summary_smtp_user"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            android:defaultValue=""
            android:key="@string/key_smtp_password"
            android:title="@string/title_smtp_password"
            android:summary="@string/summary_smtp_password"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/header_blocklist"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="@string/key_enable_blocklist"
            app:iconSpaceReserved="false"
            app:title="@string/enable_blocklist" />

        <EditTextPreference
            android:defaultValue=""
            android:key="@string/key_blocked_numbers"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="@string/title_blocked_numbers"
            android:summary="@string/summary_blocked_numbers"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- Pro: disabled with an unlock entry for free users -->
    <PreferenceCategory
        app:title="@string/header_pro_features"
        app:iconSpaceReserved="false">

        <Preference
            android:key="@string/key_pro_unlock"
            android:title="@string/title_pro_unlock"
            android:summary="@string/summary_pro_unlock"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="@string/key_forward_log"
            android:title="@string/title_forward_log"
            android:summary="@string/summary_forward_log"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="@string/key_rules"
            android:title="@string/title_rules"
            android:summary="@string/summary_rules"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:key="@string/key_rules_unmatched"
            android:title="@string/title_rules_unmatched"
            android:defaultValue="all"
            android:entries="@array/rules_unmatched_entries"
            android:entryValues="@array/rules_unmatched_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="@string/key_otp_only"
            android:title="@string/title_otp_only"
            android:summary="@string/summary_otp_only"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="@string/key_enable_notifications"
            android:title="@string/title_enable_notifications"
            app:iconSpaceReserved="false" />

        <MultiSelectListPreference
            android:key="@string/key_notification_apps"
            android:title="@string/title_notification_apps"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="@string/key_enable_filter"
            app:iconSpaceReserved="false"
            app:title="@string/enable_filter" />

        <EditTextPreference
            android:defaultValue=""
            android:key="@string/key_filter_keywords"
            android:title="@string/title_filter_keywords"
            android:summary="@string/summary_filter_keywords"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:defaultValue=""
            android:key="@string/key_filter_senders"
            android:title="@string/title_filter_senders"
            android:summary="@string/summary_filter_senders"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:defaultValue=""
            android:key="@string/key_template"
            android:title="@string/title_template"
            android:summary="@string/summary_template"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- Pro: disabled for free users (the unlock entry is in Pro features) -->
    <PreferenceCategory
        app:title="@string/header_pro_safety"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="@string/key_quiet_hours"
            android:title="@string/title_quiet_hours"
            android:summary="@string/summary_quiet_hours"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            android:defaultValue="22:00"
            android:key="@string/key_quiet_start"
            android:title="@string/title_quiet_start"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            android:defaultValue="07:00"
            android:key="@string/key_quiet_end"
            android:title="@string/title_quiet_end"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="@string/key_pause_roaming"
            android:title="@string/title_pause_roaming"
            android:summary="@string/summary_pause_roaming"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="@string/key_send_sim"
            android:title="@string/title_send_sim"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="@string/key_heartbeat"
            android:title="@string/title_heartbeat"
            android:summary="@string/summary_heartbeat"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="@string/key_low_battery"
            android:title="@string/title_low_battery"
            android:summary="@string/summary_low_battery"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="@string/key_app_lock"
            android:title="@string/title_app_lock"
            android:summary="@string/summary_app_lock"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/header_system"
        app:iconSpaceReserved="false">

        <Preference
            android:key="@string/key_send_test"
            android:title="@string/title_send_test"
            android:summary="@string/summary_send_test"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:key="@string/key_theme"
            android:title="@string/title_theme"
            android:defaultValue="system"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="@string/key_permission_status"
            android:title="@string/title_permission_status"
            android:summary="@string/summary_permission_status"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="@string/key_battery_optimization"
            android:title="@string/title_battery_optimization"
            android:summary="@string/summary_battery_optimization"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="@string/key_autostart_settings"
            android:title="@string/title_autostart_settings"
            android:summary="@string/summary_autostart_settings"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="@string/key_export"
            android:title="@string/title_export"
            android:summary="@string/summary_export"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="@string/key_import"
            android:title="@string/title_import"
            android:summary="@string/summary_import"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="@string/key_privacy_choices"
            android:title="@string/title_privacy_choices"
            android:summary="@string/summary_privacy_choices"
            app:isPreferenceVisible="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>